{
  "name": "lgview",
  "version": "0.1.0",
  "description": "A fast, local, open-source web UI for any LangGraph server. Point it at `langgraph dev` and see your graph, its state, and every run.",
  "keywords": [
    "langgraph",
    "langchain",
    "agents",
    "visualization",
    "devtools",
    "graph",
    "studio"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "lgview": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:notices && npm run build:web && npm run build:cli",
    "build:web": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build:notices": "node scripts/third-party-notices.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@xyflow/react": "^12.3.5",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younissk/lgview.git"
  },
  "bugs": {
    "url": "https://github.com/younissk/lgview/issues"
  },
  "homepage": "https://youniss.dev/lgview/",
  "author": "younissk"
}
